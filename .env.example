# Copy to .env and fill in. Never commit .env.

# Claude API key. Leave empty to use the mock LLM (no network calls).
ANTHROPIC_API_KEY=

# "claude" or "mock". Falls back to "mock" when ANTHROPIC_API_KEY is empty.
LLM_PROVIDER=mock

# Model for both LLM steps. Default: claude-sonnet-5-5 (see DECISIONS.md); claude-opus-5-5 also works.
ANTHROPIC_MODEL=

# Effort per step: low, medium, high, xhigh or max. Defaults: audience low, messages medium.
LLM_EFFORT_AUDIENCE=
LLM_EFFORT_MESSAGES=

# Set to false to disable server-side fallback when the model declines a request.
LLM_REFUSAL_FALLBACK=
