# Copy to .env and fill in. Never commit .env.

# Claude API key. Leave empty to use the mock LLM (no network calls).
ANTHROPIC_API_KEY=

# "claude" or "mock". Falls back to "mock" when ANTHROPIC_API_KEY is empty.
LLM_PROVIDER=mock

# Model for both LLM steps. Default: claude-sonnet-5-5 (see DECISIONS.md); claude-opus-5-5 also works.
ANTHROPIC_MODEL=

# Effort per step: low, medium, high, xhigh or max. Defaults: audience low, messages medium.
LLM_EFFORT_AUDIENCE=
LLM_EFFORT_MESSAGES=

# Set to false to disable server-side fallback when the model declines a request.
LLM_REFUSAL_FALLBACK=

# --- Worker (all optional; defaults shown) ---
# WORKER_RATE_PER_CHANNEL=100
# WORKER_CONCURRENCY_PER_CHANNEL=32
# WORKER_BATCH_SIZE=20
# WORKER_LEASE=30s
# WORKER_MAX_ATTEMPTS=5
# WORKER_BACKOFF_BASE=1s
# WORKER_HTTP_TIMEOUT=3s
# WORKER_POLL_INTERVAL=200ms

# --- Mock provider (all optional; defaults shown) ---
# PROVIDER_RATE_PER_CHANNEL=100
# PROVIDER_ERROR_RATE=0.05
# PROVIDER_TIMEOUT_RATE=0.01
# PROVIDER_THROTTLE_EVERY=30s
# PROVIDER_THROTTLE_FOR=2s
# PROVIDER_LATENCY_MIN_MS=50
# PROVIDER_LATENCY_MAX_MS=300
# Fix the provider's random source (e.g. 1) for reproducible runs; empty = random.
# PROVIDER_SEED=
